{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "skymd",
  "version": "../package.json",
  "identifier": "uk.9rm.skymd",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SkyMD",
        "width": 800,
        "height": 600,
        "url": "./pages/index/index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
